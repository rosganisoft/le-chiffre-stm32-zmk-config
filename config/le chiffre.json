{
  "dts_version": "v1",
  "includes": [
    "st/f0/stm32f072Xb.dtsi",
    "st/f0/stm32f072v(8-b)tx-pinctrl.dtsi",
    "dt-bindings/zmk/matrix_transform.h"
  ],
  "root": {
    "model": "Le Chiffre (stm32)",
    "compatible": [
      "sporkus,le_chiffre_stm32",
      "st,stm32f072"
    ],
    "chosen": {
      "zephyr,sram": "&sram0",
      "zephyr,flash": "&flash0",
      "zephyr,console": "&cdc_acm_uart",
      "zmk,kscan": "&kscan",
      "zmk,matrix_transform": "&transform_with_encoder"
   {
  "keyboard_name": "Le Chiffre (with Center Rotary Encoder)",
  "features": {
    "rotary_encoder": true,
    "encoder_count": 1,
    "encoder_position": "Center Thumb / Middle Matrix"
  },
  "matrix": {
    "rows": 4,
    "cols": 10,
    "total_keys": 34,
    "encoders": 1
  },
  "kle_raw": [
    ["Q", "W", "E", "R", "T", {"x": 1}, "Y", "U", "I", "O", "P"],
    ["A", "S", "D", "F", "G", {"x": 1}, "H", "J", "K", "L", ";\n:"],
    ["Z", "X", "C", "V", "B", {"x": 1}, "N", "M", ",\n<", ".\n>", "/\n?"],
    [{"x": 2}, "NAV\nSpace", "SYM\nTab", {"x": 0.25}, "KNOB\nPress", {"x": 0.25}, "NUM\nEnter", "FUN\nBspc"]
  ],
  "encoder_behavior": {
    "L0_BASE": { "cw": "KC_VOLU", "ccw": "KC_VOLD", "press": "KC_MUTE" },
    "L1_NAV_NUM": { "cw": "KC_PGDN", "ccw": "KC_PGUP", "press": "KC_HOME" },
    "L2_SYMBOL": { "cw": "KC_MS_WH_DOWN", "ccw": "KC_MS_WH_UP", "press": "KC_BTN3" },
    "L3_MEDIA_SYS": { "cw": "KC_MNXT", "ccw": "KC_MPRV", "press": "KC_MPLY" }
  }
}
